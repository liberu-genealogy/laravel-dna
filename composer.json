{
  "name": "liberu-genealogy/laravel-dna",
  "description": "Laravel wrapper around php-dna for DNA analysis and genealogy",
  "type": "library",
  "require": {
    "php": ">=8.3",
    "liberu-genealogy/php-dna": "^1.0",
    "illuminate/support": "^11.0||^12.0",
    "illuminate/database": "^11.0||^12.0"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "LaravelDna\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LaravelDna\\Providers\\DnaServiceProvider"
      ]
    }
  },
  "require-dev": {
    "rector/rector": "^2.0.0",
    "driftingly/rector-laravel": "^2.0",
    "phpunit/phpunit": "^10.0||^11.0||^12.0",
    "laravel/framework": "^11.0||^12.0",
    "mockery/mockery": "^1.6"
  }
}
